<%- include('../partials/header') %>
<%- include('../partials/navbar') %>
<div class="d-flex">
    <%- include('../partials/sidebar') %>
    <div class="main-content">
        <div class="mx-auto" style="max-width: 650px;">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <a href="/motorista" class="btn btn-sm btn-light border shadow-sm mb-2 rounded-circle"><i class="bi bi-arrow-left"></i></a>
                    <h4 class="fw-bold mb-0">Meu Histórico</h4>
                </div>
            </div>

            <% if (error) { %> <div class="alert alert-danger shadow-sm border-0"><%= error %></div> <% } %>

            <!-- Filtros Modernos tipo App -->
            <div class="card shadow-sm border-0 mb-4 bg-white">
                <div class="card-body p-3">
                    <form action="/motorista/historico" method="GET" class="row g-2 align-items-end">
                        <div class="col-5">
                            <label class="form-label text-muted small fw-bold mb-1">Início</label>
                            <input type="date" name="data_inicio" class="form-control form-control-sm" value="<%= filtros.data_inicio || '' %>" required>
                        </div>
                        <div class="col-5">
                            <label class="form-label text-muted small fw-bold mb-1">Fim</label>
                            <input type="date" name="data_fim" class="form-control form-control-sm" value="<%= filtros.data_fim || '' %>" required>
                        </div>
                        <div class="col-2 text-center">
                            <button type="submit" class="btn btn-primary btn-sm w-100 h-100 d-flex align-items-center justify-content-center" style="min-height: 31px;">
                                <i class="bi bi-search"></i>
                            </button>
                        </div>
                    </form>
                    <% if(filtros.data_inicio) { %>
                        <div class="text-end mt-2"><a href="/motorista/historico" class="text-danger small text-decoration-none">Limpar Filtros</a></div>
                    <% } %>
                </div>
            </div>

            <!-- Navegação por Abas (Tabs) estilo App -->
            <ul class="nav nav-pills nav-fill bg-white rounded-3 shadow-sm p-1 mb-4 border" id="pills-tab" role="tablist">
                <li class="nav-item" role="presentation">
                    <button class="nav-link active fw-bold" id="pills-abast-tab" data-bs-toggle="pill" data-bs-target="#pills-abast" type="button" role="tab">
                        <i class="bi bi-fuel-pump me-1"></i> Abastecimentos
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link fw-bold" id="pills-manut-tab" data-bs-toggle="pill" data-bs-target="#pills-manut" type="button" role="tab">
                        <i class="bi bi-tools me-1"></i> Manutenções
                    </button>
                </li>
            </ul>

            <!-- Conteúdo das Abas -->
            <div class="tab-content" id="pills-tabContent">
                
                <!-- ABA ABASTECIMENTO -->
                <div class="tab-pane fade show active" id="pills-abast" role="tabpanel">
                    <% abastecimentos.forEach(ab => { %>
                        <div class="app-history-card">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <div>
                                    <h6 class="fw-bold mb-0 text-dark"><i class="bi bi-calendar2-event me-1"></i> <%= new Date(ab.created_at).toLocaleDateString('pt-BR') %></h6>
                                    <small class="text-muted"><%= ab.estabelecimento %> - <%= ab.cidade %></small>
                                </div>
                                <div class="text-end">
                                    <span class="badge bg-primary-subtle text-primary border border-primary fs-6"><%= ab.km %> KM</span>
                                </div>
                            </div>
                            <hr class="my-2 opacity-25">
                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    <span class="d-block fw-bold text-success">R$ <%= parseFloat(ab.valor).toLocaleString('pt-BR', {minimumFractionDigits:2}) %></span>
                                    <small class="text-muted"><%= ab.litros %>L • <%= ab.tipo_1 %></small>
                                </div>
                                <button class="btn btn-sm btn-light border rounded-pill text-primary" data-bs-toggle="modal" data-bs-target="#modalAbast<%= ab.id %>">Ver Fotos</button>
                            </div>
                        </div>

                        <!-- Modal de Fotos (Abastecimento) -->
                        <div class="modal fade" id="modalAbast<%= ab.id %>" tabindex="-1">
                            <div class="modal-dialog modal-dialog-centered">
                                <div class="modal-content border-0 shadow">
                                    <div class="modal-header bg-light">
                                        <h6 class="modal-title fw-bold">Comprovantes</h6>
                                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                    </div>
                                    <div class="modal-body text-center">
                                        <div id="carouselAbast<%= ab.id %>" class="carousel slide" data-bs-ride="false">
                                            <div class="carousel-inner rounded">
                                                <div class="carousel-item active">
                                                    <img src="<%= ab.foto_bomba %>" class="d-block w-100 rounded" alt="Bomba">
                                                    <div class="mt-2 fw-bold text-muted">1. Foto da Bomba</div>
                                                </div>
                                                <div class="carousel-item">
                                                    <img src="<%= ab.foto_nota %>" class="d-block w-100 rounded" alt="Nota">
                                                    <div class="mt-2 fw-bold text-muted">2. Nota Fiscal</div>
                                                </div>
                                                <div class="carousel-item">
                                                    <img src="<%= ab.foto_painel %>" class="d-block w-100 rounded" alt="Painel">
                                                    <div class="mt-2 fw-bold text-muted">3. Painel KM</div>
                                                </div>
                                            </div>
                                            <button class="carousel-control-prev" type="button" data-bs-target="#carouselAbast<%= ab.id %>" data-bs-slide="prev">
                                                <span class="carousel-control-prev-icon bg-dark rounded-circle p-2" aria-hidden="true"></span>
                                            </button>
                                            <button class="carousel-control-next" type="button" data-bs-target="#carouselAbast<%= ab.id %>" data-bs-slide="next">
                                                <span class="carousel-control-next-icon bg-dark rounded-circle p-2" aria-hidden="true"></span>
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    <% }) %>
                    <% if(abastecimentos.length === 0) { %>
                        <div class="text-center py-5 text-muted">
                            <i class="bi bi-inbox fs-1 d-block mb-2"></i>
                            Nenhum abastecimento encontrado.
                        </div>
                    <% } %>
                </div>

                <!-- ABA MANUTENÇÃO -->
                <div class="tab-pane fade" id="pills-manut" role="tabpanel">
                    <% manutencoes.forEach(mn => { 
                        let fotosManut = [];
                        try { fotosManut = typeof mn.fotos === 'string' ? JSON.parse(mn.fotos) : mn.fotos; } catch(e) {}
                    %>
                        <div class="app-history-card danger">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <div>
                                    <h6 class="fw-bold mb-0 text-dark"><i class="bi bi-calendar2-event me-1"></i> <%= new Date(mn.created_at).toLocaleDateString('pt-BR') %></h6>
                                    <small class="text-muted"><%= mn.estabelecimento %></small>
                                </div>
                                <div class="text-end">
                                    <span class="badge <%= mn.tipo==='Preventiva'?'bg-info':'bg-warning text-dark' %> border"><%= mn.tipo %></span>
                                </div>
                            </div>
                            <hr class="my-2 opacity-25">
                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    <span class="d-block fw-bold text-danger">R$ <%= parseFloat(mn.valor).toLocaleString('pt-BR', {minimumFractionDigits:2}) %></span>
                                    <small class="text-muted fw-bold"><%= mn.km %> KM</small>
                                </div>
                                <% if(fotosManut.length > 0) { %>
                                    <button class="btn btn-sm btn-light border rounded-pill text-danger" data-bs-toggle="modal" data-bs-target="#modalManut<%= mn.id %>">Ver Fotos</button>
                                <% } else { %>
                                    <small class="text-muted">Sem fotos</small>
                                <% } %>
                            </div>
                        </div>

                        <!-- Modal de Fotos (Manutenção) -->
                        <% if(fotosManut.length > 0) { %>
                        <div class="modal fade" id="modalManut<%= mn.id %>" tabindex="-1">
                            <div class="modal-dialog modal-dialog-centered">
                                <div class="modal-content border-0 shadow">
                                    <div class="modal-header bg-light">
                                        <h6 class="modal-title fw-bold">Comprovantes</h6>
                                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                    </div>
                                    <div class="modal-body text-center">
                                        <div id="carouselManut<%= mn.id %>" class="carousel slide" data-bs-ride="false">
                                            <div class="carousel-inner rounded">
                                                <% fotosManut.forEach((foto, index) => { %>
                                                    <div class="carousel-item <%= index === 0 ? 'active' : '' %>">
                                                        <img src="<%= foto %>" class="d-block w-100 rounded" alt="Foto">
                                                        <div class="mt-2 fw-bold text-muted">Foto <%= index + 1 %></div>
                                                    </div>
                                                <% }) %>
                                            </div>
                                            <% if(fotosManut.length > 1) { %>
                                                <button class="carousel-control-prev" type="button" data-bs-target="#carouselManut<%= mn.id %>" data-bs-slide="prev">
                                                    <span class="carousel-control-prev-icon bg-dark rounded-circle p-2" aria-hidden="true"></span>
                                                </button>
                                                <button class="carousel-control-next" type="button" data-bs-target="#carouselManut<%= mn.id %>" data-bs-slide="next">
                                                    <span class="carousel-control-next-icon bg-dark rounded-circle p-2" aria-hidden="true"></span>
                                                </button>
                                            <% } %>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <% } %>
                    <% }) %>
                    <% if(manutencoes.length === 0) { %>
                        <div class="text-center py-5 text-muted">
                            <i class="bi bi-inbox fs-1 d-block mb-2"></i>
                            Nenhuma manutenção encontrada.
                        </div>
                    <% } %>
                </div>

            </div>
        </div>
    </div>
</div>
<%- include('../partials/footer') %>