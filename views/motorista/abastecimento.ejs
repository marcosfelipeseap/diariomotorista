<%- include('../partials/header') %>
<%- include('../partials/navbar') %>
<div class="d-flex">
    <%- include('../partials/sidebar') %>
    <div class="main-content">
        <div class="mx-auto" style="max-width: 650px;">
            <div class="d-flex align-items-center mb-4">
                <a href="/motorista" class="btn btn-sm btn-light border shadow-sm mb-2 rounded-circle"><i class="bi bi-arrow-left"></i></a>
                <h4 class="fw-bold mb-0">Registrar Abastecimento</h4>
            </div>

            <% if (error) { %> <div class="alert alert-danger shadow-sm border-0"><%= error %></div> <% } %>
            
            <form action="/motorista/abastecimento" method="POST" enctype="multipart/form-data" class="card shadow-sm p-4 p-md-5 mb-5" id="formAbastecimento">
                
                <h6 class="fw-bold text-primary mb-3"><i class="bi bi-info-circle me-2"></i>Dados do Combustível</h6>
                <div class="row g-3 mb-4">
                    <div class="col-md-6">
                        <label class="form-label text-muted small fw-bold">Combustível 1</label>
                        <select name="tipo_1" class="form-select bg-light" required>
                            <option value="Diesel S10">Diesel S10</option>
                            <option value="Arla">Arla</option>
                            <option value="Gasolina">Gasolina</option>
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label text-muted small fw-bold">Combustível 2 (Opcional)</label>
                        <select name="tipo_2" class="form-select bg-light">
                            <option value="">Nenhum</option>
                            <option value="Arla">Arla</option>
                            <option value="Diesel S10">Diesel S10</option>
                        </select>
                    </div>
                    <div class="col-6">
                        <label class="form-label text-muted small fw-bold">Litros Totais</label>
                        <input type="number" step="0.01" name="litros" class="form-control" required placeholder="0.00">
                    </div>
                    <div class="col-6">
                        <label class="form-label text-muted small fw-bold">Valor Total (R$)</label>
                        <input type="number" step="0.01" name="valor" class="form-control" required placeholder="0.00">
                    </div>
                </div>
                
                <hr class="text-secondary opacity-25 my-1">

                <h6 class="fw-bold text-warning mt-4 mb-3"><i class="bi bi-speedometer2 me-2"></i>Quilometragem</h6>
                <div class="mb-4">
                    <label class="form-label text-muted small fw-bold">KM do Veículo <span class="text-danger">(Último registrado: <%= ultimo_km %>)</span></label>
                    <input type="number" name="km" class="form-control form-control-lg fw-bold text-primary bg-primary-subtle border-primary" min="<%= ultimo_km %>" required placeholder="Informe o KM atual">
                </div>

                <hr class="text-secondary opacity-25 my-1">

                <h6 class="fw-bold text-dark mt-4 mb-3"><i class="bi bi-geo-alt me-2"></i>Localização</h6>
                <div class="row g-3 mb-4">
                    <div class="col-12"><input type="text" name="estabelecimento" class="form-control" placeholder="Nome do Posto / Estabelecimento" required></div>
                    <div class="col-8"><input type="text" name="cidade" class="form-control" placeholder="Cidade" required></div>
                    <div class="col-4"><input type="text" name="estado" class="form-control text-uppercase" placeholder="UF" maxlength="2" required></div>
                </div>

                <hr class="text-secondary opacity-25 my-1">

                <h6 class="fw-bold text-dark mt-4 mb-3"><i class="bi bi-camera me-2"></i>Comprovantes Visuais</h6>
                <div class="row g-3">
                    <!-- Bomba -->
                    <div class="col-12">
                        <label class="form-label text-muted small fw-bold">1. Foto da Bomba</label>
                        <input type="file" name="foto_bomba" id="input_bomba" class="form-control" accept="image/*" required onchange="mostrarPreview(this, 'preview_bomba')">
                        <div id="preview_bomba" class="mt-2 d-none position-relative" style="width: fit-content;">
                            <img src="" class="img-thumbnail shadow-sm" style="max-height: 150px; border-radius: 8px;">
                            <button type="button" class="btn btn-danger btn-sm position-absolute top-0 end-0 m-1 rounded-circle px-2" onclick="removerPreview('input_bomba', 'preview_bomba')"><i class="bi bi-x fs-5"></i></button>
                        </div>
                    </div>
                    <!-- Nota -->
                    <div class="col-12">
                        <label class="form-label text-muted small fw-bold">2. Foto da Nota Fiscal</label>
                        <input type="file" name="foto_nota" id="input_nota" class="form-control" accept="image/*" required onchange="mostrarPreview(this, 'preview_nota')">
                        <div id="preview_nota" class="mt-2 d-none position-relative" style="width: fit-content;">
                            <img src="" class="img-thumbnail shadow-sm" style="max-height: 150px; border-radius: 8px;">
                            <button type="button" class="btn btn-danger btn-sm position-absolute top-0 end-0 m-1 rounded-circle px-2" onclick="removerPreview('input_nota', 'preview_nota')"><i class="bi bi-x fs-5"></i></button>
                        </div>
                    </div>
                    <!-- Painel -->
                    <div class="col-12">
                        <label class="form-label text-muted small fw-bold">3. Foto do Painel (Mostrando KM)</label>
                        <input type="file" name="foto_painel" id="input_painel" class="form-control" accept="image/*" required onchange="mostrarPreview(this, 'preview_painel')">
                        <div id="preview_painel" class="mt-2 d-none position-relative" style="width: fit-content;">
                            <img src="" class="img-thumbnail shadow-sm" style="max-height: 150px; border-radius: 8px;">
                            <button type="button" class="btn btn-danger btn-sm position-absolute top-0 end-0 m-1 rounded-circle px-2" onclick="removerPreview('input_painel', 'preview_painel')"><i class="bi bi-x fs-5"></i></button>
                        </div>
                    </div>
                </div>

                <button type="submit" class="btn btn-primary btn-lg w-100 mt-5 rounded-pill shadow-sm form-submit-btn">Salvar Registro</button>
            </form>
        </div>
    </div>
</div>

<!-- TELA DE CARREGAMENTO (ESTILO APP) -->
<div id="app-loader">
    <div class="spinner-border text-primary mb-3" role="status"></div>
    <h4 class="fw-bold text-dark">Enviando dados...</h4>
    <p class="text-muted small text-center px-4">Otimizando e salvando as fotos de forma segura.<br>Por favor, aguarde e não feche o aplicativo.</p>
</div>

<!-- Biblioteca de Compressão de Imagem no Navegador -->
<script src="https://cdn.jsdelivr.net/npm/browser-image-compression@2.0.1/dist/browser-image-compression.js"></script>

<script>
    // Sistema de Previews Individuais
    function mostrarPreview(input, previewId) {
        const previewDiv = document.getElementById(previewId);
        const img = previewDiv.querySelector('img');
        
        if (input.files && input.files[0]) {
            img.src = URL.createObjectURL(input.files[0]);
            previewDiv.classList.remove('d-none');
        } else {
            previewDiv.classList.add('d-none');
        }
    }

    function removerPreview(inputId, previewId) {
        const input = document.getElementById(inputId);
        const previewDiv = document.getElementById(previewId);
        input.value = ''; // Limpa o arquivo
        previewDiv.classList.add('d-none');
    }

    // Processamento de Compressão e Envio
    document.getElementById('formAbastecimento').addEventListener('submit', async function(e) {
        e.preventDefault(); 
        
        if (!this.checkValidity()) {
            this.reportValidity();
            return;
        }

        const btnSubmit = this.querySelector('.form-submit-btn');
        const originalText = btnSubmit.innerHTML;
        btnSubmit.disabled = true;
        btnSubmit.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Otimizando fotos...';
        document.getElementById('app-loader').classList.add('active');

        const options = { maxSizeMB: 0.8, maxWidthOrHeight: 1280, useWebWorker: true };

        try {
            const fileInputs = this.querySelectorAll('input[type="file"]');
            
            for (let input of fileInputs) {
                if (input.files.length > 0) {
                    const dataTransfer = new DataTransfer();
                    for (let i = 0; i < input.files.length; i++) {
                        const file = input.files[i];
                        if (file.type.startsWith('image/')) {
                            const compressedFile = await imageCompression(file, options);
                            dataTransfer.items.add(new File([compressedFile], compressedFile.name, { type: compressedFile.type }));
                        } else {
                            dataTransfer.items.add(file);
                        }
                    }
                    input.files = dataTransfer.files;
                }
            }
            
            btnSubmit.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Salvando...';
            this.submit();

        } catch (error) {
            console.error('Erro ao comprimir:', error);
            alert('Erro ao processar as fotos. Tente novamente.');
            btnSubmit.disabled = false;
            btnSubmit.innerHTML = originalText;
            document.getElementById('app-loader').classList.remove('active');
        }
    });
</script>
<%- include('../partials/footer') %>