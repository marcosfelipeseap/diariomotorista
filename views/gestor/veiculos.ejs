<%- include('../partials/header') %>
<%- include('../partials/navbar') %>
<div class="d-flex">
    <%- include('../partials/sidebar') %>
    <div class="main-content">
        <h4 class="fw-bold mb-4">Gestão de Veículos</h4>
        
        <% if (error) { %> <div class="alert alert-danger shadow-sm border-0"><%= error %></div> <% } %>
        <% if (success) { %> <div class="alert alert-success shadow-sm border-0"><%= success %></div> <% } %>

        <!-- Card de Cadastro -->
        <div class="card mb-4 shadow-sm border-0">
            <div class="card-header bg-white"><i class="bi bi-plus-circle me-2"></i>Cadastrar Novo Veículo</div>
            <div class="card-body p-4">
                <form action="/gestor/veiculos" method="POST" class="row g-3">
                    <div class="col-md-3">
                        <label class="form-label text-muted small fw-bold">Placa</label>
                        <input type="text" name="placa" class="form-control text-uppercase" placeholder="ABC-1234" required>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label text-muted small fw-bold">Marca</label>
                        <input type="text" name="marca" class="form-control" placeholder="Ex: Volvo" required>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label text-muted small fw-bold">Modelo</label>
                        <input type="text" name="modelo" class="form-control" placeholder="Ex: FH 540" required>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label text-muted small fw-bold">Tipo</label>
                        <select name="tipo" class="form-select" required>
                            <option value="" disabled selected>Selecione...</option>
                            <option value="Caminhão">Caminhão</option>
                            <option value="Carro">Carro</option>
                            <option value="Van">Van</option>
                        </select>
                    </div>
                    <div class="col-12 mt-4 text-end">
                        <button type="submit" class="btn btn-primary px-4"><i class="bi bi-save me-2"></i>Salvar Veículo</button>
                    </div>
                </form>
            </div>
        </div>

        <!-- Tabela -->
        <div class="card shadow-sm border-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0 align-middle">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4">Placa</th>
                            <th>Marca / Modelo</th>
                            <th>Tipo</th>
                            <th class="text-end pe-4">Ações</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% veiculos.forEach(v => { %>
                            <tr>
                                <td class="ps-4">
                                    <span class="badge border border-secondary text-dark bg-light fs-6 rounded-3 px-3 py-2" style="font-family: monospace;">
                                        <%= v.placa %>
                                    </span>
                                </td>
                                <td><strong class="text-dark"><%= v.marca %></strong> <span class="text-muted"><%= v.modelo %></span></td>
                                <td><span class="badge bg-secondary-subtle text-secondary px-2 py-1"><%= v.tipo %></span></td>
                                <td class="text-end pe-4">
                                    <!-- Botões que abrem modais -->
                                    <button class="btn btn-sm btn-outline-primary" data-bs-toggle="modal" data-bs-target="#editModal<%= v.id %>"><i class="bi bi-pencil"></i></button>
                                    <button class="btn btn-sm btn-outline-danger" data-bs-toggle="modal" data-bs-target="#deleteModal<%= v.id %>"><i class="bi bi-trash"></i></button>
                                </td>
                            </tr>

                            <!-- Modal Editar -->
                            <div class="modal fade" id="editModal<%= v.id %>" tabindex="-1">
                                <div class="modal-dialog">
                                    <div class="modal-content">
                                        <form action="/gestor/veiculos/editar" method="POST">
                                            <div class="modal-header">
                                                <h5 class="modal-title">Editar Veículo</h5>
                                                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                            </div>
                                            <div class="modal-body">
                                                <input type="hidden" name="id" value="<%= v.id %>">
                                                <div class="mb-3">
                                                    <label class="form-label">Placa</label>
                                                    <input type="text" name="placa" class="form-control text-uppercase" value="<%= v.placa %>" required>
                                                </div>
                                                <div class="mb-3">
                                                    <label class="form-label">Marca</label>
                                                    <input type="text" name="marca" class="form-control" value="<%= v.marca %>" required>
                                                </div>
                                                <div class="mb-3">
                                                    <label class="form-label">Modelo</label>
                                                    <input type="text" name="modelo" class="form-control" value="<%= v.modelo %>" required>
                                                </div>
                                                <div class="mb-3">
                                                    <label class="form-label">Tipo</label>
                                                    <select name="tipo" class="form-select" required>
                                                        <option value="Caminhão" <%= v.tipo === 'Caminhão' ? 'selected' : '' %>>Caminhão</option>
                                                        <option value="Carro" <%= v.tipo === 'Carro' ? 'selected' : '' %>>Carro</option>
                                                        <option value="Van" <%= v.tipo === 'Van' ? 'selected' : '' %>>Van</option>
                                                    </select>
                                                </div>
                                            </div>
                                            <div class="modal-footer">
                                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                                                <button type="submit" class="btn btn-primary">Salvar Alterações</button>
                                            </div>
                                        </form>
                                    </div>
                                </div>
                            </div>

                            <!-- Modal Excluir -->
                            <div class="modal fade" id="deleteModal<%= v.id %>" tabindex="-1">
                                <div class="modal-dialog">
                                    <div class="modal-content">
                                        <form action="/gestor/veiculos/excluir" method="POST">
                                            <div class="modal-header">
                                                <h5 class="modal-title text-danger">Excluir Veículo?</h5>
                                                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                            </div>
                                            <div class="modal-body">
                                                <input type="hidden" name="id" value="<%= v.id %>">
                                                <p>Tem certeza que deseja excluir o veículo <strong><%= v.placa %></strong>?</p>
                                                <p class="text-muted small">Veículos com histórico de uso não poderão ser excluídos.</p>
                                            </div>
                                            <div class="modal-footer">
                                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                                                <button type="submit" class="btn btn-danger">Sim, Excluir</button>
                                            </div>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
<%- include('../partials/footer') %>