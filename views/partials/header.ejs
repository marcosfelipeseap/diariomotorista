<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
    
    <!-- Configurações do PWA -->
    <link rel="manifest" href="/manifest.json">
    <meta name="theme-color" content="#0d6efd">
    <link rel="apple-touch-icon" href="/img/logo.png">
    
    <title>Motorista - UGTR</title>

    <!-- CDN Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link rel="stylesheet" href="/css/style.css">

    <style>
        body { background-color: #f8f9fa; }
        
        /* Animações de Pulso */
        .pulse-dot-success { animation: pulse-dot-success 2s infinite; display: inline-block; width: 10px; height: 10px; border-radius: 50%; background-color: #198754; margin-left: 6px; }
        @keyframes pulse-dot-success { 0% { box-shadow: 0 0 0 0 rgba(25, 135, 84, 0.7); } 70% { box-shadow: 0 0 0 5px rgba(25, 135, 84, 0); } 100% { box-shadow: 0 0 0 0 rgba(25, 135, 84, 0); } }

        .pulse-dot-danger { animation: pulse-dot-danger 2s infinite; display: inline-block; width: 10px; height: 10px; border-radius: 50%; background-color: #dc3545; margin-left: 6px; }
        @keyframes pulse-dot-danger { 0% { box-shadow: 0 0 0 0 rgba(220, 53, 69, 0.7); } 70% { box-shadow: 0 0 0 5px rgba(220, 53, 69, 0); } 100% { box-shadow: 0 0 0 0 rgba(220, 53, 69, 0); } }
        
        /* Ajustes finos do Menu Lateral */
        .sidebar { background-color: #ffffff; border-right: 1px solid #dee2e6; min-height: calc(100vh - 60px); }
        .sidebar .nav-link { color: #495057; padding: 0.6rem 1rem; border-radius: 6px; margin-bottom: 2px; transition: all 0.2s; }
        .sidebar .nav-link:hover { background-color: #f1f3f5; color: #212529; }
        .sidebar .nav-link.active { color: #0d6efd !important; background-color: #e7f1ff; font-weight: bold; }
        .sidebar .nav-link i { margin-right: 8px; font-size: 1.15rem; }

        /* Estilo do Botão Flutuante de Instalação PWA */
        #btn-instalar-app {
            display: none; /* Fica oculto até o navegador confirmar que pode instalar */
            position: fixed;
            bottom: 20px;
            right: 20px;
            z-index: 9999;
            box-shadow: 0 4px 10px rgba(0,0,0,0.3);
            border-radius: 50px;
            padding: 10px 20px;
            font-weight: bold;
        }
    </style>

    <!-- Registro do Service Worker -->
    <script>
        if ('serviceWorker' in navigator) {
            window.addEventListener('load', () => {
                navigator.serviceWorker.register('/sw.js')
                    .then(reg => console.log('Service Worker registrado com sucesso!'))
                    .catch(err => console.log('Erro ao registrar Service Worker:', err));
            });
        }
    </script>
</head>
<body>

    <!-- Botão de Instalação Flutuante -->
    <button id="btn-instalar-app" class="btn btn-primary">
        <i class="bi bi-download me-2"></i> Instalar Aplicativo
    </button>

    <!-- Script para gerenciar o Botão de Instalação -->
    <script>
        let eventoInstalacao;
        const btnInstalar = document.getElementById('btn-instalar-app');

        // O navegador dispara este evento se o app não estiver instalado
        window.addEventListener('beforeinstallprompt', (e) => {
            // Impede o prompt padrão do Chrome de aparecer imediatamente
            e.preventDefault();
            // Salva o evento para ser disparado quando o usuário clicar no botão
            eventoInstalacao = e;
            // Mostra o nosso botão personalizado
            btnInstalar.style.display = 'block';
        });

        // Quando o motorista clica no botão
        btnInstalar.addEventListener('click', async () => {
            if (eventoInstalacao) {
                // Mostra a tela de instalação nativa do Android/iOS
                eventoInstalacao.prompt();
                
                // Aguarda a resposta do usuário
                const escolha = await eventoInstalacao.userChoice;
                if (escolha.outcome === 'accepted') {
                    console.log('Motorista aceitou a instalação');
                    // Esconde o botão após instalar
                    btnInstalar.style.display = 'none';
                }
                eventoInstalacao = null;
            }
        });

        // Se o app já foi instalado, garante que o botão suma
        window.addEventListener('appinstalled', () => {
            btnInstalar.style.display = 'none';
            console.log('Aplicativo foi instalado com sucesso');
        });
    </script>
</body>
<!-- O fechamento da tag </html> acontece no seu footer.ejs -->